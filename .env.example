# Docker Compose settings. Keep secrets in .aniu/local/.env, not in Git.
ANIU_PORT=8000
ANIU_BIND_ADDRESS=127.0.0.1
ANIU_LAN=0
ANIU_ALLOWED_HOSTS=localhost,127.0.0.1,localhost.localdomain
ANIU_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ANIU_LOG_LEVEL=info
# Optional fixed login token. Leave unset to configure one on the local login page.
# ANIU_AUTH_TOKEN=
# ANIU_MASTER_SECRET_KEY=
# ANIU_MASTER_SECRET_KEY_PREVIOUS=
